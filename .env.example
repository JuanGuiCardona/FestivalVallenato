# Copie este archivo como .env y cambie los valores. El .env real NUNCA se sube al repositorio.
# Todos los valores de este ejemplo son ficticios.

# Clave secreta de Django. Genere una propia con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY="cambie-esta-clave-por-una-generada"
# 1 en desarrollo; 0 en un servidor (activa HTTPS y cookies seguras)
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Solo si comparte el sistema por un enlace https (túnel o servidor)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Conexión a MySQL 8.4 (base y usuario creados según GUIA.md)
DB_NAME=festival_votaciones
DB_USER=festival
DB_PASSWORD=escriba-aqui-su-contrasena
DB_HOST=127.0.0.1
DB_PORT=3306
# Para la demostración sin MySQL, quite el comentario de la siguiente línea:
# DB_ENGINE=sqlite

# Valores iniciales de seguridad (preliminares*). Después se cambian desde el panel:
# Panel → Configuración general (A-06), sin editar este archivo.
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_SEGUNDOS=300
VOTOS_MAX_POR_MINUTO=10
